# Node does not read this file automatically. Copy to .env and run:
# node --env-file=.env server.js
APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
SECURE_COOKIE=0
# Optional locally; required absolute persistent directory in production.
# DATA_DIR=
# BACKUP_DIR=
# Required only for password recovery (registration/login work without SMTP):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
