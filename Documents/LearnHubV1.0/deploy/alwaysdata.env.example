# Configure estas variáveis no painel do site ou em um arquivo PRIVADO fora do código.
# Substitua SUA_CONTA pelo nome real da conta; não configure IP/HOST/PORT:
# a hospedagem fornece esses três valores.
NODE_ENV=production
NODEJS_VERSION=24
APP_URL=https://SUA_CONTA.alwaysdata.net
SECURE_COOKIE=1
DATA_DIR=/home/SUA_CONTA/private/learnhub-data
BACKUP_DIR=/home/SUA_CONTA/private/learnhub-backups
SMTP_HOST=smtp-SUA_CONTA.alwaysdata.net
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
# O alwaysdata autoriza SMTP sem senha para serviços hospedados em seus servidores.
# Fora do alwaysdata, configure credenciais conforme o seu provedor SMTP.
MAIL_FROM=SUA_CONTA@alwaysdata.net
